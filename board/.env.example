# Copy this file to .env.local and fill it in. .env.local is gitignored: never commit real keys.

# --- Used by the app (built into the static site; all safe to be public) ---
# Supabase project URL (Supabase dashboard > Connect), e.g. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=
# Publishable key (sb_publishable_...). This is Supabase's new name for the "anon" key. It is meant
# to be public; Row Level Security protects the data.
VITE_SUPABASE_ANON_KEY=
# Optional. Allowed university usernames (lowercase). Default: two letters + five digits, e.g. xy12345
# VITE_USERNAME_PATTERN=^[a-z]{2}[0-9]{5}$
# Optional. "trust" (username only, the default) or "email_code" (6-digit code emailed to
# username@bristol.ac.uk; needs custom SMTP in Supabase, see README).
# VITE_AUTH_MODE=trust

# --- Used only by the local scripts (never in the app or a GitHub workflow) ---
# Secret key (sb_secret_...). Supabase's new name for "service_role". It bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=
# Supabase personal access token (sbp_...) and project ref, used to apply supabase/schema.sql
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
